{
  "name": "jarvis-desktop",
  "version": "0.1.0",
  "description": "A local-first glass companion for macOS",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "Victor Udeh",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "dev": "node scripts/tokens.mjs && electron-vite dev",
    "build": "node scripts/tokens.mjs && pnpm native:build && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "native:build": "node scripts/build-native.mjs",
    "icon:build": "node scripts/build-icon.mjs",
    "models:setup": "node scripts/setup-models.mjs",
    "package": "pnpm build && pnpm icon:build && electron-builder --mac dir",
    "dist": "pnpm build && pnpm icon:build && electron-builder --mac dmg zip",
    "preview": "vite --config vite.preview.config.ts --host 127.0.0.1",
    "format": "prettier --write src tests scripts *.ts *.json *.md",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.267",
    "@fontsource/sora": "5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.143.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "croner": "10.0.1",
    "electron-liquid-glass": "1.1.1",
    "liquid-gooey": "0.2.1",
    "lucide-react": "1.43.0",
    "motion": "13.2.0",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "thinking-orbs": "0.3.1",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electron/osx-sign": "1.3.3",
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
